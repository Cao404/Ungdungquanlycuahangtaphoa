// ============================================================
//  QUẢN LÝ CỬA HÀNG TẠP HÓA - Prisma Schema (SQL Server)
//  Khớp 100% với database/schema.sql
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─── 1. NguoiDung ────────────────────────────────────────────
model NguoiDung {
  id        Int      @id @default(autoincrement())
  hoTen     String   @db.NVarChar(100)
  taiKhoan  String   @unique @db.NVarChar(50)
  matKhau   String   @db.NVarChar(255)
  vaiTro    String   @default("nhanvien") @db.NVarChar(20) // 'admin' | 'nhanvien'
  trangThai Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime

  phieuNhaps           PhieuNhap[]
  phieuNhapXacNhans    PhieuNhap[]           @relation("NguoiXacNhanPhieuNhap")
  hoaDons              HoaDon[]
  phieuKiemKes         PhieuKiemKe[]         @relation("NguoiTaoPhieuKiemKe")
  phieuKiemKeDuyets    PhieuKiemKe[]         @relation("NguoiDuyetPhieuKiemKe")
  giaoDichKhos         GiaoDichKho[]
  thuCongNos           ThuCongNo[]
  traCongNoNhaCungCaps TraCongNoNhaCungCap[]

  @@map("NguoiDung")
}

// ─── 2. SanPham ──────────────────────────────────────────────
model SanPham {
  id         Int      @id @default(autoincrement())
  ten        String   @db.NVarChar(200)
  thuongHieu String?  @db.NVarChar(100)
  danhMuc    String   @db.NVarChar(100)
  moTa       String?  @db.NVarChar(Max)
  hinhAnh    String?  @db.NVarChar(500)
  createdAt  DateTime @default(now()) @db.DateTime

  bienThes BienThe[]

  @@index([ten], map: "IX_SanPham_Ten")
  @@index([danhMuc], map: "IX_SanPham_DanhMuc")
  @@map("SanPham")
}

// ─── 3. BienThe ──────────────────────────────────────────────
// Tách riêng giaTri (DECIMAL) và donVi (NVARCHAR) để sort/filter chính xác
model BienThe {
  id            Int     @id @default(autoincrement())
  sanPhamId     Int
  giaTri        Decimal @db.Decimal(10, 2) // phần số: 1, 500, 2.5
  donVi         String  @db.NVarChar(20) // "Lít", "ml", "kg", "g", "Cái", "Gói"
  giaNhap       Decimal @default(0) @db.Decimal(12, 2)
  giaBan        Decimal @db.Decimal(12, 2)
  soLuongTon    Int     @default(0)
  nguongCanhBao Int     @default(5)
  trangThai     Boolean @default(true)
  barcode       String? @unique @db.NVarChar(64)

  sanPham           SanPham            @relation(fields: [sanPhamId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_BienThe_SanPham")
  chiTietPhieuNhaps ChiTietPhieuNhap[]
  chiTietHoaDons    ChiTietHoaDon[]
  chiTietKiemKes    ChiTietKiemKe[]
  giaoDichKhos      GiaoDichKho[]
  loHangs           LoHang[]

  @@index([sanPhamId], map: "IX_BienThe_SanPhamId")
  @@index([giaTri], map: "IX_BienThe_GiaTri")
  @@map("BienThe")
}

// ─── 4. NhaCungCap ───────────────────────────────────────────
model NhaCungCap {
  id        Int      @id @default(autoincrement())
  ten       String   @db.NVarChar(200)
  sdt       String?  @db.NVarChar(20)
  diaChi    String?  @db.NVarChar(300)
  createdAt DateTime @default(now()) @db.DateTime

  phieuNhaps PhieuNhap[]
  traCongNos TraCongNoNhaCungCap[]

  @@map("NhaCungCap")
}

// ─── 5. PhieuNhap ────────────────────────────────────────────
model PhieuNhap {
  id                Int       @id @default(autoincrement())
  nhaCungCapId      Int
  nguoiTaoId        Int
  ngayNhap          DateTime  @default(now()) @db.DateTime
  tongTien          Decimal   @default(0) @db.Decimal(14, 2)
  ghiChu            String?   @db.NVarChar(Max)
  trangThai         String    @default("DRAFT") @db.VarChar(20)
  nguoiXacNhanId    Int?
  ngayXacNhan       DateTime? @db.DateTime
  hinhThucTT        String    @default("tienmat") @db.NVarChar(20)
  trangThaiTT       String    @default("chuaTT") @db.NVarChar(10)
  soTienDaThanhToan Decimal   @default(0) @db.Decimal(14, 2)

  nhaCungCap   NhaCungCap                  @relation(fields: [nhaCungCapId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhieuNhap_NhaCungCap")
  nguoiTao     NguoiDung                   @relation(fields: [nguoiTaoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhieuNhap_NguoiDung")
  nguoiXacNhan NguoiDung?                  @relation("NguoiXacNhanPhieuNhap", fields: [nguoiXacNhanId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhieuNhap_NguoiXacNhan")
  chiTiets     ChiTietPhieuNhap[]
  phanBoTraNos PhanBoTraCongNoNhaCungCap[]

  @@index([ngayNhap(sort: Desc)], map: "IX_PhieuNhap_NgayNhap")
  @@index([trangThai], map: "IX_PhieuNhap_TrangThai")
  @@map("PhieuNhap")
}

// Một lần cửa hàng trả tiền nhà cung cấp; tự cấn vào các phiếu nhập cũ nhất.
model TraCongNoNhaCungCap {
  id           Int      @id @default(autoincrement())
  nhaCungCapId Int
  nguoiTraId   Int
  soTien       Decimal  @db.Decimal(14, 2)
  hinhThucTT   String   @db.NVarChar(20)
  ghiChu       String?  @db.NVarChar(500)
  ngayTra      DateTime @default(now()) @db.DateTime

  nhaCungCap NhaCungCap                  @relation(fields: [nhaCungCapId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_TraCongNoNCC_NhaCungCap")
  nguoiTra   NguoiDung                   @relation(fields: [nguoiTraId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_TraCongNoNCC_NguoiDung")
  phanBos    PhanBoTraCongNoNhaCungCap[]

  @@index([nhaCungCapId, ngayTra(sort: Desc)], map: "IX_TraCongNoNCC_NhaCungCap_NgayTra")
  @@map("TraCongNoNhaCungCap")
}

model PhanBoTraCongNoNhaCungCap {
  id          Int     @id @default(autoincrement())
  traCongNoId Int
  phieuNhapId Int
  soTien      Decimal @db.Decimal(14, 2)

  traCongNo TraCongNoNhaCungCap @relation(fields: [traCongNoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhanBoTraCongNoNCC_TraCongNo")
  phieuNhap PhieuNhap           @relation(fields: [phieuNhapId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhanBoTraCongNoNCC_PhieuNhap")

  @@unique([traCongNoId, phieuNhapId], map: "UQ_PhanBoTraCongNoNCC_Tra_Phieu")
  @@index([phieuNhapId], map: "IX_PhanBoTraCongNoNCC_PhieuNhap")
  @@map("PhanBoTraCongNoNhaCungCap")
}

// ─── 6. ChiTietPhieuNhap ─────────────────────────────────────
model ChiTietPhieuNhap {
  id          Int       @id @default(autoincrement())
  phieuNhapId Int
  bienTheId   Int
  soLuong     Int
  giaNhap     Decimal   @db.Decimal(12, 2)
  maLo        String?   @db.NVarChar(100)
  ngaySanXuat DateTime? @db.Date
  hanSuDung   DateTime? @db.Date

  phieuNhap PhieuNhap @relation(fields: [phieuNhapId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ChiTietPhieuNhap_PhieuNhap")
  bienThe   BienThe   @relation(fields: [bienTheId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ChiTietPhieuNhap_BienThe")
  loHang    LoHang?

  @@map("ChiTietPhieuNhap")
}

// ─── 7. KhachHang ────────────────────────────────────────────
model KhachHang {
  id        Int      @id @default(autoincrement())
  ten       String   @db.NVarChar(200)
  sdt       String?  @db.NVarChar(20)
  diaChi    String?  @db.NVarChar(300)
  createdAt DateTime @default(now()) @db.DateTime

  hoaDons    HoaDon[]
  thuCongNos ThuCongNo[]

  @@map("KhachHang")
}

// ─── 8. HoaDon ───────────────────────────────────────────────
model HoaDon {
  id                Int      @id @default(autoincrement())
  nguoiBanId        Int
  khachHangId       Int? // nullable: khách vãng lai
  ngayBan           DateTime @default(now()) @db.DateTime
  tongTien          Decimal  @default(0) @db.Decimal(14, 2)
  giamGia           Decimal  @default(0) @db.Decimal(12, 2)
  lyDoGiamGia       String?  @db.NVarChar(255)
  hinhThucTT        String   @default("tienmat") @db.NVarChar(20) // 'tienmat' | 'chuyenkhoan' | 'congno'
  trangThaiTT       String   @default("daTT") @db.NVarChar(10) // 'daTT' | 'chuaTT'
  requestId         String?  @unique @db.NVarChar(64)
  tamTinh           Decimal  @default(0) @db.Decimal(14, 2)
  thue              Decimal  @default(0) @db.Decimal(12, 2)
  tienKhachDua      Decimal? @db.Decimal(14, 2)
  tienThua          Decimal? @db.Decimal(14, 2)
  soTienDaThanhToan Decimal  @default(0) @db.Decimal(14, 2)

  nguoiBan     NguoiDung         @relation(fields: [nguoiBanId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_HoaDon_NguoiDung")
  khachHang    KhachHang?        @relation(fields: [khachHangId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_HoaDon_KhachHang")
  chiTiets     ChiTietHoaDon[]
  phanBoThuNos PhanBoThuCongNo[]

  @@index([ngayBan(sort: Desc)], map: "IX_HoaDon_NgayBan")
  @@index([nguoiBanId], map: "IX_HoaDon_NguoiBanId")
  @@map("HoaDon")
}

// Một lần khách trả nợ; tiền được tự cấn vào các hóa đơn cũ nhất.
model ThuCongNo {
  id          Int      @id @default(autoincrement())
  khachHangId Int
  nguoiThuId  Int
  soTien      Decimal  @db.Decimal(14, 2)
  hinhThucTT  String   @db.NVarChar(20)
  ghiChu      String?  @db.NVarChar(500)
  ngayThu     DateTime @default(now()) @db.DateTime

  khachHang KhachHang         @relation(fields: [khachHangId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ThuCongNo_KhachHang")
  nguoiThu  NguoiDung         @relation(fields: [nguoiThuId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ThuCongNo_NguoiDung")
  phanBos   PhanBoThuCongNo[]

  @@index([khachHangId, ngayThu(sort: Desc)], map: "IX_ThuCongNo_KhachHang_NgayThu")
  @@map("ThuCongNo")
}

model PhanBoThuCongNo {
  id          Int     @id @default(autoincrement())
  thuCongNoId Int
  hoaDonId    Int
  soTien      Decimal @db.Decimal(14, 2)

  thuCongNo ThuCongNo @relation(fields: [thuCongNoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhanBoThuCongNo_ThuCongNo")
  hoaDon    HoaDon    @relation(fields: [hoaDonId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhanBoThuCongNo_HoaDon")

  @@unique([thuCongNoId, hoaDonId], map: "UQ_PhanBoThuCongNo_Thu_HoaDon")
  @@index([hoaDonId], map: "IX_PhanBoThuCongNo_HoaDon")
  @@map("PhanBoThuCongNo")
}

// ─── 9. ChiTietHoaDon ────────────────────────────────────────
model ChiTietHoaDon {
  id        Int     @id @default(autoincrement())
  hoaDonId  Int
  bienTheId Int
  soLuong   Int
  donGia    Decimal @db.Decimal(12, 2) // LƯU CỨNG giá tại thời điểm bán
  thanhTien Decimal @db.Decimal(14, 2)

  hoaDon    HoaDon           @relation(fields: [hoaDonId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ChiTietHoaDon_HoaDon")
  bienThe   BienThe          @relation(fields: [bienTheId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ChiTietHoaDon_BienThe")
  phanBoLos PhanBoLoHoaDon[]

  @@map("ChiTietHoaDon")
}

// Mỗi lần nhập tạo một lô riêng. Hạn sử dụng thuộc lô, không thuộc sản phẩm.
model LoHang {
  id                 Int       @id @default(autoincrement())
  bienTheId          Int
  chiTietPhieuNhapId Int?      @unique
  maLo               String?   @db.NVarChar(100)
  ngaySanXuat        DateTime? @db.Date
  hanSuDung          DateTime? @db.Date
  ngayNhap           DateTime  @default(now()) @db.DateTime
  soLuongNhap        Int
  soLuongCon         Int
  giaNhap            Decimal   @db.Decimal(12, 2)
  trangThai          String    @default("DANG_BAN") @db.VarChar(20)

  bienThe          BienThe           @relation(fields: [bienTheId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_LoHang_BienThe")
  chiTietPhieuNhap ChiTietPhieuNhap? @relation(fields: [chiTietPhieuNhapId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_LoHang_ChiTietPhieuNhap")
  phanBoHoaDons    PhanBoLoHoaDon[]

  @@index([bienTheId, hanSuDung], map: "IX_LoHang_BienThe_HanSuDung")
  @@index([hanSuDung, soLuongCon], map: "IX_LoHang_HanSuDung_SoLuongCon")
  @@map("LoHang")
}

// Ghi nhận hóa đơn đã trừ từ lô nào để truy vết và tính giá vốn chính xác.
model PhanBoLoHoaDon {
  id              Int @id @default(autoincrement())
  chiTietHoaDonId Int
  loHangId        Int
  soLuong         Int

  chiTietHoaDon ChiTietHoaDon @relation(fields: [chiTietHoaDonId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhanBoLoHoaDon_ChiTietHoaDon")
  loHang        LoHang        @relation(fields: [loHangId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhanBoLoHoaDon_LoHang")

  @@unique([chiTietHoaDonId, loHangId], map: "UQ_PhanBoLoHoaDon_ChiTiet_Lo")
  @@index([loHangId], map: "IX_PhanBoLoHoaDon_LoHang")
  @@map("PhanBoLoHoaDon")
}

// ─── 10. GiaoDichKho ─────────────────────────────────────────
model GiaoDichKho {
  id              Int      @id @default(autoincrement())
  bienTheId       Int
  loaiGiaoDich    String   @db.NVarChar(50) // 'nhap_hang' | 'ban_hang' | 'kiem_ke' | 'tra_hang'
  soLuongThayDoi  Int
  soLuongTruoc    Int
  soLuongSau      Int
  thamChieuLoai   String?  @db.NVarChar(50) // 'PhieuNhap' | 'HoaDon' | 'PhieuKiemKe'
  thamChieuId     Int?
  nguoiThucHienId Int
  thoiGian        DateTime @default(now()) @db.DateTime
  ghiChu          String?  @db.NVarChar(500)

  bienThe       BienThe   @relation(fields: [bienTheId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_GiaoDichKho_BienThe")
  nguoiThucHien NguoiDung @relation(fields: [nguoiThucHienId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_GiaoDichKho_NguoiDung")

  @@index([bienTheId], map: "IX_GiaoDichKho_BienTheId")
  @@index([thoiGian(sort: Desc)], map: "IX_GiaoDichKho_ThoiGian")
  @@map("GiaoDichKho")
}

// ─── 11. PhieuKiemKe ─────────────────────────────────────────
model PhieuKiemKe {
  id           Int       @id @default(autoincrement())
  nguoiTaoId   Int
  ngayKiemKe   DateTime  @default(now()) @db.DateTime
  ghiChu       String?   @db.NVarChar(Max)
  trangThai    String    @default("cho_duyet") @db.VarChar(20)
  nguoiDuyetId Int?
  ngayDuyet    DateTime? @db.DateTime
  lyDoTuChoi   String?   @db.NVarChar(255)

  nguoiTao   NguoiDung       @relation("NguoiTaoPhieuKiemKe", fields: [nguoiTaoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhieuKiemKe_NguoiDung")
  nguoiDuyet NguoiDung?      @relation("NguoiDuyetPhieuKiemKe", fields: [nguoiDuyetId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PhieuKiemKe_NguoiDuyet")
  chiTiets   ChiTietKiemKe[]

  @@index([ngayKiemKe(sort: Desc)], map: "IX_PhieuKiemKe_NgayKiemKe")
  @@map("PhieuKiemKe")
}

// ─── 12. ChiTietKiemKe ───────────────────────────────────────
model ChiTietKiemKe {
  id                  Int     @id @default(autoincrement())
  phieuKiemKeId       Int
  bienTheId           Int
  soLuongHeThong      Int
  soLuongThucTe       Int
  nguyenNhanChenhLech String? @db.NVarChar(255)

  phieuKiemKe PhieuKiemKe @relation(fields: [phieuKiemKeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ChiTietKiemKe_PhieuKiemKe")
  bienThe     BienThe     @relation(fields: [bienTheId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ChiTietKiemKe_BienThe")

  @@map("ChiTietKiemKe")
}

// Cấu hình thuế tách khỏi nghiệp vụ hóa đơn để thay đổi quy định không cần sửa mã nguồn.
model CauHinhThue {
  id             Int       @id @default(autoincrement())
  ten            String    @db.NVarChar(150)
  loaiThue       String    @db.NVarChar(50)
  phuongPhapTinh String    @db.NVarChar(50)
  nguongDoanhThu Decimal   @default(0) @db.Decimal(14, 2)
  tyLe           Decimal   @db.Decimal(5, 2)
  hieuLucTu      DateTime  @db.Date
  hieuLucDen     DateTime? @db.Date
  trangThai      Boolean   @default(true)
  ghiChu         String?   @db.NVarChar(500)
  createdById    Int?
  createdAt      DateTime  @default(now()) @db.DateTime

  @@index([trangThai, hieuLucTu], map: "IX_CauHinhThue_HieuLuc")
  @@map("CauHinhThue")
}

model NhatKyHeThong {
  id         Int      @id @default(autoincrement())
  userId     Int?
  hanhDong   String   @db.NVarChar(80)
  trangThai  String   @db.NVarChar(20)
  doiTuong   String?  @db.NVarChar(50)
  doiTuongId String?  @db.NVarChar(64)
  metadata   String?  @db.NVarChar(1000)
  createdAt  DateTime @default(now()) @db.DateTime

  @@index([createdAt(sort: Desc)], map: "IX_NhatKyHeThong_CreatedAt")
  @@index([userId], map: "IX_NhatKyHeThong_UserId")
  @@map("NhatKyHeThong")
}
