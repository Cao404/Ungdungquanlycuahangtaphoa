{
  "expo": {
    "name": "Quản Lý Tạp Hóa",
    "slug": "quanlycuahangtaphoa-mobile",
    "version": "1.0.0",
    "scheme": "quanlytaphoa",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Quản Lý Tạp Hóa dùng camera để quét mã vạch sản phẩm.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "API_BASE_URL": "http://192.168.1.5:5000/api"
    }
  }
}
